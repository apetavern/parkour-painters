@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
	<div class="results">
	<h1>Results</h1>
		<p>Spraycans:@GameManager.Instance.CollectableCount</p>
	</div>
</root>

@code
{
	protected override void OnStart()
	{
		AddClass("hidden");
	}

	protected override void OnFixedUpdate()
	{
		if (GameManager.Instance.State == GameState.PostGame)
			RemoveClass("hidden");
	}

	protected override int BuildHash() => System.HashCode.Combine(GameManager.Instance.CollectableCount);
}